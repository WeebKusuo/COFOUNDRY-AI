# CoFoundry AI — environment configuration (Contract v3.0, Section 22)
# Copy to .env (repository root) for local development. Never commit the real file.

NODE_ENV=development
PORT=5000

# Exact browser origin. Development: the Vite dev server (it proxies /api to PORT).
# Production: the single HTTPS origin that serves both the SPA and /api.
APP_ORIGIN=http://localhost:5173

# MongoDB must run as a replica set so transactions work (required in production).
# Local single-node replica set example:
#   mongod --replSet rs0 --dbpath ./data  then  mongosh --eval "rs.initiate()"
MONGODB_URI=mongodb://127.0.0.1:27017/cofoundry?replicaSet=rs0

SESSION_TTL_SECONDS=28800

# --- AI interviewer and evaluator (Phases 7-10) -----------------------------------------------
# LLM_PROVIDER: disabled (default; interviews cannot start) | groq | openai-compatible (a
# self-hosted vLLM / llama.cpp / Ollama /v1 endpoint) | mock (automated tests only; refused in
# production). Models are never hardcoded: set both explicitly. Suggested Groq models
# (verify availability at https://console.groq.com/docs/models before use):
#   LLM_INTERVIEWER_MODEL=llama-3.3-70b-versatile   (Llama 3.3 Community Licence)
#   LLM_EVALUATOR_MODEL=openai/gpt-oss-120b         (Apache-2.0)
LLM_PROVIDER=disabled
LLM_INTERVIEWER_MODEL=
LLM_EVALUATOR_MODEL=
# Backend-only secret (Groq keys start with gsk_). Never exposed to the browser or logs.
LLM_API_KEY=
# Optional base URL. Groq default: https://api.groq.com/openai/v1 (https only; http only on localhost).
LLM_BASE_URL=
# Per-attempt timeout and attempts (retries with exponential backoff, honouring Retry-After on 429).
LLM_TIMEOUT_MS=20000
LLM_MAX_ATTEMPTS=3

# --- Speech service (services/speech: faster-whisper STT + Piper TTS) ---------------------------
# disabled (default: typed answers only, questions shown as text) | http | mock (tests only)
SPEECH_PROVIDER=disabled
SPEECH_SERVICE_URL=http://127.0.0.1:8765
# Shared secret, at least 32 characters; the same value is set for the speech service.
SPEECH_SERVICE_TOKEN=
SPEECH_TIMEOUT_MS=90000

# --- Code execution sandbox (self-hosted Judge0 CE >= 1.13.1 on an isolated host) ---------------
# disabled (default: runs and hidden tests are unavailable; no coding score) | judge0 | mock (tests only)
CODE_EXECUTION_PROVIDER=disabled
# https, or http on localhost only (e.g. an SSH tunnel to the isolated Judge0 host).
JUDGE0_URL=
# Judge0 AUTHN_TOKEN (sent as X-Auth-Token).
JUDGE0_AUTH_TOKEN=
# Language ids of your Judge0 instance (GET /languages). CE defaults: 63 Node.js, 71 Python 3.
JUDGE0_LANGUAGE_ID_JAVASCRIPT=63
JUDGE0_LANGUAGE_ID_PYTHON=71
JUDGE0_TIMEOUT_MS=30000

DEMO_MODE=true

# Password for every seeded demo account (npm run db:seed). 12-128 characters.
# Demo accounts are shared identities: never reuse this for a real person.
# Without it, development seeding uses the default "cofoundry-demo-2026"; production requires it.
SEED_DEMO_PASSWORD=cofoundry-demo-2026

# Private directory for uploaded resume PDFs. Must not be inside the served web build.
# Development default: apps/server/var/resumes (git-ignored). Required in production.
# RESUME_STORAGE_DIR=/srv/cofoundry/resumes

# Optional
LOG_LEVEL=info
# Number of trusted reverse-proxy hops in front of Express (0 = none).
TRUST_PROXY_HOPS=0
# Loopback-only readiness probe port (0 disables it).
INTERNAL_PORT=5001
